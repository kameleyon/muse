# Server Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter API Configuration
VITE_OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_API_KEY=your-openrouter-key
VITE_API_KEY=your-api-key

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://magicmuse.io,https://api.magicmuse.io,https://www.magicmuse.io

# JWT Configuration
JWT_SECRET=your-jwt-secret

# Default AI Model Configuration
VITE_DEFAULT_CONTENT_MODEL=qwen/qwen-plus
VITE_DEFAULT_RESEARCH_MODEL=google/gemini-2.5-flash-lite-preview-06-17
VITE_BOOK_STRUCTURE_MODEL=anthropic/claude-3.7-sonnet:thinking
VITE_DEFAULT_CHAT_MODEL=qwen/qwen-plus
VITE_DEFAULT_QUALITY_MODEL=google/gemini-2.5-flash

# URLs and application settings
VITE_BACKEND_URL=http://localhost:9998
VITE_API_BASE_URL=http://localhost:9998/api
VITE_SITE_URL=http://localhost:5173
VITE_APP_NAME=MagicMuse

# Feature flags
VITE_PLUGIN_PWA_DISABLED=true
